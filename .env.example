# Google Apps Script Web App URL (deployed from scripts/google-apps-script.js)
# This is read server-side by /api/rsvp.js — never expose it as VITE_*.
RSVP_SHEET_URL=https://script.google.com/macros/s/XXXXX/exec

# Optional shared secret. If set, must match SHARED_SECRET in the Apps Script.
RSVP_SHARED_SECRET=
